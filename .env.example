# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Optional: override the AI model without a code change (default o4-mini, a
# cheap reasoning model). Any Responses-API model works — reasoning models
# (o4-mini, gpt-5.x) and standard chat models (gpt-4o-mini) are auto-detected.
OPENAI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# MT5 sync uses per-connection bearer tokens stored (hashed) in the
# mt5_connections table — no shared webhook secret is needed.

# Admin Bootstrap (server-only)
BOOTSTRAP_SECRET=
