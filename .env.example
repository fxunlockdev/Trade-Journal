# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Optional: override the AI model without a code change (default o4-mini, a
# cheap reasoning model). Any Responses-API model works — reasoning models
# (o4-mini, gpt-5.x) and standard chat models (gpt-4o-mini) are auto-detected.
OPENAI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Static-IP proxy for Myfxbook calls (fixes IP-bound "Invalid session" on
# Vercel). Set to a static-IP HTTP proxy URL, e.g. QuotaGuard Static:
#   MYFXBOOK_PROXY_URL=http://user:pass@static.quotaguard.com:9293
# Unset = calls go direct (reliable only from a fixed-IP host).
MYFXBOOK_PROXY_URL=

# MT5 Sync (Myfxbook bridge) — encrypts stored Myfxbook credentials at rest.
# Generate once: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=
# Protects POST /api/myfxbook/sync (batch sync for external schedulers like
# cron-job.org). Any random string ≥16 chars.
CRON_SECRET=

# Admin Bootstrap (server-only)
BOOTSTRAP_SECRET=

# Live Education site (separate URL). When set, all "Live Education" links point
# here and open in a new tab; when unset they fall back to the in-app /education.
NEXT_PUBLIC_EDUCATION_URL=
